    "ui": "node src/index.js serve",
    "chat": "node src/index.js chat",
    "doctor": "node src/index.js doctor",
    "models": "node src/index.js models",
    "pull": "node src/index.js pull",
    "index": "node src/index.js index .",
    "docs": "node src/index.js ask-docs",
    "identity": "node src/index.js identity",
    "memory": "node src/index.js memory",
